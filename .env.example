# ==============================================================================
# KEYDSO MAANTA — Environment Variables Template
# Copy this file to .env in respective directories and populate real values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (apps/api/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL / Supabase Database Connection
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Authentication & JWT Secrets (Generate with: openssl rand -base64 64)
JWT_SECRET=change-this-to-a-cryptographically-secure-random-string-at-least-64-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change-this-to-another-secure-random-string-at-least-64-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Financial Cryptographic Keys & Policies
RECEIPT_HMAC_SECRET=generate-random-32-byte-hex-key-for-receipt-hmac-verification
EXPENSE_DUAL_APPROVAL_THRESHOLD=500.00
STORAGE_BUCKET_PRIVATE=keydso-private-evidence

# Security & CORS
CORS_ORIGIN=http://localhost:5173

# Optional: Outgoing Email Service
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.university.edu
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Keydso Maanta SRC" <noreply@src.university.edu>

# Optional: Web Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@src.university.edu

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/.env)
# (Publicly visible in browser bundle - NEVER PUT PRIVILEGED SECRETS HERE)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-PUBLIC-KEY]
VITE_APP_TITLE="Keydso Maanta - University SRC Management"
VITE_ENABLE_PWA_SERVICE_WORKER=true
VITE_MAX_UPLOAD_SIZE_MB=10
